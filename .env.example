# ==============================================================================
# TheAlgorithm - Environment Variables (.dev.vars for Wrangler)
# ==============================================================================
#
# IMPORTANT: Never commit actual API keys to version control!
# Copy this file to `.dev.vars` for local development with Wrangler:
#   cp .env.example .dev.vars
#
# For production/preview deployments on Cloudflare Pages, set these directly
# in the Cloudflare Dashboard under Settings -> Environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Default LLM Provider Settings
# ------------------------------------------------------------------------------
# Defines the primary model provider used if the user doesn't Bring Their Own Key (BYOK)
LLM_PROVIDER=openai

# ------------------------------------------------------------------------------
# Server-Side API Keys (Optional if solely relying on BYOK client-side)
# ------------------------------------------------------------------------------
# Only populated if you are hosting a public instance without enforcing BYOK.
# The `functions/api/analyze.js` logic expects these exact names when parsing
# the server's environment context (`env`).

OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
XAI_API_KEY=your-xai-grok-key-here
MISTRAL_API_KEY=your-mistral-key-here

# ------------------------------------------------------------------------------
# Rate Limiting / KV Namespace (Cloudflare Workers)
# ------------------------------------------------------------------------------
# In Cloudflare, KV namespaces are linked via `wrangler.toml` and the Dashboard.
# You do NOT put the KV ID here. However, any secret keys needed for external
# rate limiting services (if used instead of Cloudflare KV) would go here.
# (Currently, the app relies strictly on native `env.KV_RATELIMIT`).
